# ---------------------------------------------------------------------------
# EditexSoft — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# NEXT_PUBLIC_ ile başlayanlar tarayıcıya gönderilir; gizli bilgi koymayın.
# ---------------------------------------------------------------------------

# Sitenin canlı adresi (canonical, sitemap ve Open Graph için)
NEXT_PUBLIC_SITE_URL=https://editexsoft.com

# Üyelik / abonelik paneli (ileride devreye alınacak web uygulaması)
NEXT_PUBLIC_APP_URL=https://app.editexsoft.com

# Masaüstü uygulamasının kurulum dosyası
# Dosyayı public/downloads/ altına koyabilir ya da bir CDN/blob adresi verebilirsiniz.
NEXT_PUBLIC_DOWNLOAD_URL=/downloads/EditexSoftSetup.exe
NEXT_PUBLIC_APP_VERSION=3.4.2
NEXT_PUBLIC_APP_RELEASE_DATE=2026-08-18
NEXT_PUBLIC_APP_SIZE_MB=84
# Doldurulursa indirme sayfasında SHA-256 doğrulama kutusu görünür
NEXT_PUBLIC_APP_SHA256=

# WhatsApp destek hattı — ülke kodu dahil, yalnızca rakam
NEXT_PUBLIC_WHATSAPP_PHONE=905550000000
NEXT_PUBLIC_PHONE_DISPLAY=+90 555 000 00 00

# ---------------------------------------------------------------------------
# İletişim formu (sunucu tarafı — tarayıcıya gönderilmez)
# Aşağıdakilerden biri yeterlidir. Hiçbiri tanımlı değilse form çalışır ama
# mesaj yalnızca sunucu günlüğüne yazılır.
# ---------------------------------------------------------------------------

# 1) Resend ile e-posta gönderimi (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=EditexSoft <bildirim@editexsoft.com>
CONTACT_TO_EMAIL=info@editexsoft.com

# 2) Ya da genel bir webhook (Slack, Make, Zapier, n8n ...)
CONTACT_WEBHOOK_URL=
